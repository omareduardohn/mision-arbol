rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helpers ---------- */
    function isAuth() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function rol() {
      return isAuth() ? userDoc().rol : '';
    }
    function esControl()          { return rol() == 'control'; }
    function esVisorNacional()    { return rol() == 'visor_nacional'; }
    function esReporteNacional()  { return rol() == 'reporte_nacional'; }
    function esReporteEstadal()   { return rol() == 'reporte_estadal'; }
    function esDashboardNacional(){ return rol() == 'dashboard_nacional'; }
    function esDashboardEstadal() { return rol() == 'dashboard_estadal'; }
    function miEstado()   { return userDoc().estado; }
    function miGerencia() { return userDoc().gerencia; }

    /* ---------- USUARIOS ---------- */
    /* ---------- USUARIOS ---------- */
    match /usuarios/{uid} {
      allow get: if isAuth() && (request.auth.uid == uid || esControl());
      allow list: if isAuth() && esControl();
      allow create: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.rol in [
                         'reporte_estadal', 'reporte_nacional', 'visor_nacional',
                         'dashboard_nacional', 'dashboard_estadal'
                       ]
                    && request.resource.data.estadoCuenta == 'pendiente';
      allow update: if
        esControl()
        ||
        (
          isAuth() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasAny(['rol','estadoCuenta','estado','gerencia','suspendido','cedula','email','intentosFallidos','ultimoIntentoFallido'])
        )
        ||
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['intentosFallidos','ultimoIntentoFallido','suspendido'])
          && request.resource.data.intentosFallidos is int
          && request.resource.data.intentosFallidos == resource.data.get('intentosFallidos', 0) + 1
          && request.resource.data.intentosFallidos <= 3
          && request.resource.data.suspendido == (request.resource.data.intentosFallidos >= 3)
          && (
            !('ultimoIntentoFallido' in resource.data)
            || request.time > resource.data.ultimoIntentoFallido + duration.value(15, 's')
          )
        );
      allow delete: if esControl();
    }

    /* ---------- CÉDULAS (hash anti-duplicados) ---------- */
    match /cedulas/{hashId} {
      // get individual OK (registro público verifica duplicados)
      // list restringido a control (evita enumeración)
      allow get: if true;

      allow list: if isAuth() && esControl();

      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/cedulas/$(hashId));
      allow delete: if esControl();
    }



    /* ---------- REPORTES ---------- */
    match /reportes/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal()  && resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional()   && resource.data.gerencia == miGerencia()) ||
        (esReporteEstadal()    && resource.data.ubicacion.estado == miEstado()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal()  && resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional()   && resource.data.gerencia == miGerencia()) ||
        (esReporteEstadal()    && resource.data.ubicacion.estado == miEstado())
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal() && request.resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerencia == miGerencia())
      );

      allow update: if esControl()
                    || resource.data.usuarioId == request.auth.uid;

      // No permitir delete si el reporte está vinculado a una planificación
      allow delete: if esControl()
                    || (resource.data.usuarioId == request.auth.uid
                        && resource.data.planificacionId == null);
    }

    /* ---------- EMAILS LOOKUP (hash → uid) ---------- */
    // Colección mínima que mapea hash(email) → uid. Sirve para que el
    // cliente pueda ubicar el documento de un usuario al que se le está
    // contando un intento fallido de login, sin exponer el email real.
    //
    // Seguridad: el hash es SHA-256 irreversible. Un atacante solo podría
    // confirmar "este email existe" si conoce el email exacto, pero no
    // obtiene password, rol, ni ningún otro dato.
    match /emails-lookup/{hashEmail} {
      // Lectura pública: el cliente la necesita ANTES de autenticarse.
      allow get: if true;
      allow list: if false;  // evitar enumeración masiva

      // Se crea cuando:
      //   a) Un usuario se registra → crea su propio lookup.
      //   b) Un admin ejecuta backfill → crea lookups de otros usuarios.
      allow create: if isAuth()
                    && request.resource.data.uid is string
                    && (
                      request.resource.data.uid == request.auth.uid
                      || esControl()
                    );

      // No se modifica desde el cliente.
      allow update: if false;
      allow delete: if esControl();
    }

    /* ---------- INTENTOS PUBLICOS (contador sin auth) ---------- */
    match /intentos-publicos/{uid} {
      allow get: if true;
      allow list: if false;

      // Create: primer intento fallido. El cliente es anónimo.
      // Aceptamos cualquier contador entre 1 y 3.
      allow create: if
        request.resource.data.contador is number
        && request.resource.data.contador >= 1
        && request.resource.data.contador <= 3;

      // Update: incrementos sucesivos (rate-limited a 15s).
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contador','ultimo'])
        && request.resource.data.contador is number
        && request.resource.data.contador == resource.data.contador + 1
        && request.resource.data.contador <= 3
        && (
          !('ultimo' in resource.data)
          || request.time > resource.data.ultimo + duration.value(15, 's')
        );

      // Delete: el propio usuario (al loguearse bien) o un admin.
      allow delete: if isAuth() && (request.auth.uid == uid || esControl());
    }

    /* ---------- PERSONAL ---------- */
    match /personal/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardNacional() || esDashboardEstadal() ||
        (esReporteEstadal()  && resource.data.estado == miEstado()) ||
        (esReporteNacional() && resource.data.gerencia == miGerencia())
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardNacional() || esDashboardEstadal() ||
        (esReporteEstadal()  && resource.data.estado == miEstado()) ||
        (esReporteNacional() && resource.data.gerencia == miGerencia())
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal()  && request.resource.data.estado == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerencia == miGerencia())
      );

      // Update/delete: solo el creador o control
      allow update, delete: if esControl()
        || (isAuth() && resource.data.creadoPor == request.auth.uid);
    }

    /* ---------- PLANIFICACIÓN ---------- */
    match /planificacion/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteEstadal()  && resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteEstadal()  && resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal()  && request.resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerenciaUsuario == miGerencia())
      );

      allow update, delete: if esControl()
                            || resource.data.usuarioId == request.auth.uid;
    }

    /* ---------- REPORTES ESPECIALES ---------- */
    match /reportesEspeciales/{id} {
      allow get: if isAuth();
      allow list: if isAuth();
      allow create, delete: if esControl();

      // Update: control total; usuarios comunes solo pueden AGREGAR
      // una respuesta (append-only).
      allow update: if esControl()
        || (
          isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas'])
          && request.resource.data.respuestas.size() == resource.data.respuestas.size() + 1
        );
    }

    /* ---------- VIVEROS ---------- */
    match /viveros/{id} {
      // Lectura: control, reporte_nacional (Producción), dashboard roles
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Producción') ||
        (esDashboardNacional() && miGerencia() == 'Producción') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Producción') ||
        (esDashboardNacional() && miGerencia() == 'Producción') ||
        esDashboardEstadal()
      );

      // Escritura: control o reporte_nacional de Producción
      allow create, update, delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Producción')
      );
    }

    /* ---------- BANCOS DE TIERRA ---------- */
    match /bancosTierra/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Plantación') ||
        (esDashboardNacional() && miGerencia() == 'Plantación') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Plantación') ||
        (esDashboardNacional() && miGerencia() == 'Plantación') ||
        esDashboardEstadal()
      );

      allow create, update, delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Plantación')
      );
    }

    /* ---------- BRIGADAS ---------- */
    match /brigadas/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Organización') ||
        (esDashboardNacional() && miGerencia() == 'Organización') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Organización') ||
        (esDashboardNacional() && miGerencia() == 'Organización') ||
        esDashboardEstadal()
      );

      allow create: if isAuth() && (
        (esControl() || (esReporteNacional() && miGerencia() == 'Organización'))
        && request.resource.data.tipo == 'ecologica'
      );

      allow update: if isAuth() && (
        (esControl() || (esReporteNacional() && miGerencia() == 'Organización'))
        && request.resource.data.tipo == 'ecologica'
      );

      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      );
    }

    /* ---------- CONTADORES (códigos únicos) ---------- */
    // Solo para el sistema de códigos VIV-/BRG-. Cualquier usuario
    // autenticado puede incrementar el contador (necesario para crear
    // viveros/brigadas), pero NO puede resetearlo hacia atrás ni borrarlo.
    match /contadores/{tipo} {
      allow get: if isAuth();

      allow create: if isAuth()
                    && request.resource.data.ultimo is number
                    && request.resource.data.ultimo > 0;

      // Solo se permite incrementar. Nunca retroceder ni mantener igual.
      allow update: if isAuth()
                    && request.resource.data.ultimo is number
                    && request.resource.data.ultimo > resource.data.ultimo;

      // Protección: nadie puede borrar el contador (evita reset).
      allow delete: if false;
    }

  }
    /* ---------- FORMACIONES (Núcleo de Formación) ---------- */
    // Colección para cursos, talleres, diplomados y otras actividades
    // educativas. Cada documento tiene un `codigoUnico` (FRM-XXXXXX).
    //
    // NOTA: este bloque usa funciones inline (get() directo) en lugar de
    // los helpers esControl()/esReporteNacional() porque el compilador de
    // Firestore no los resuelve bien dentro de este match cuando el
    // archivo es grande.
    match /formaciones/{id} {
      allow get, list: if request.auth != null && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['control', 'visor_nacional', 'dashboard_estadal']
        || (
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in ['reporte_nacional', 'dashboard_nacional']
          && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.gerencia == 'Formación'
        )
      );

      allow create: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'control'
                      || (
                        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'reporte_nacional'
                        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.gerencia == 'Formación'
                      )
                    )
                    && request.resource.data.codigoUnico is string
                    && request.resource.data.codigoUnico.matches('^FRM-[0-9]{6}$')
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0
                    && request.resource.data.estatus in ['planificada', 'en_curso', 'finalizada', 'cancelada'];

      allow update: if request.auth != null
                    && (
                      get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'control'
                      || (
                        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'reporte_nacional'
                        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.gerencia == 'Formación'
                      )
                    )
                    && request.resource.data.estatus in ['planificada', 'en_curso', 'finalizada', 'cancelada'];

      allow delete: if request.auth != null
                    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'control';
    }
}