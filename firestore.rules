rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ========== HELPERS ========== */
    function isAuth() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function rol() {
      return isAuth() ? userDoc().rol : '';
    }
    function esControl()          { return rol() == 'control'; }
    function esVisorNacional()    { return rol() == 'visor_nacional'; }
    function esReporteNacional()  { return rol() == 'reporte_nacional'; }
    function esReporteEstadal()   { return rol() == 'reporte_estadal'; }
    function esDashboardNacional(){ return rol() == 'dashboard_nacional'; }
    function esDashboardEstadal() { return rol() == 'dashboard_estadal'; }
    function miEstado()   { return userDoc().estado; }
    function miGerencia() { return userDoc().gerencia; }

    /* ========== USUARIOS ========== */
    match /usuarios/{uid} {
      allow get: if isAuth() && (request.auth.uid == uid || esControl());
      allow list: if isAuth() && esControl();
      allow create: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.rol in [
                         'reporte_estadal', 'reporte_nacional', 'visor_nacional',
                         'dashboard_nacional', 'dashboard_estadal'
                       ]
                    && request.resource.data.estadoCuenta == 'pendiente';

      // Update: 2 caminos.
      //   1. control: puede todo.
      //   2. dueño autenticado:
      //      a) puede modificar campos no sensibles, O
      //      b) puede RESETEAR sus propios intentos (intentosFallidos=0,
      //         suspendido=false) al loguearse bien.
      //
      // Eliminada: la rama anónima que permitía a cualquiera incrementar
      // intentos de otros usuarios. Esto era un vector de bloqueo arbitrario.
      allow update: if
        esControl()
        ||
        (
          isAuth() && request.auth.uid == uid
          && (
            // Rama A: modificar campos NO sensibles
            !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['rol','estadoCuenta','estado','gerencia','suspendido','cedula','email','intentosFallidos','ultimoIntentoFallido'])
            ||
            // Rama B: solo puede RESETEAR sus propios intentos a 0
            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['intentosFallidos','ultimoIntentoFallido','suspendido'])
              && request.resource.data.intentosFallidos == 0
              && request.resource.data.suspendido == false
            )
          )
        );
      allow delete: if esControl();
    }

    /* ========== CÉDULAS ========== */
    match /cedulas/{hashId} {
      allow get: if true;
      allow list: if isAuth() && esControl();
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/cedulas/$(hashId));
      allow delete: if esControl();
    }

    /* ========== REPORTES ========== */
    match /reportes/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal()  && resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional()   && resource.data.gerencia == miGerencia()) ||
        (esReporteEstadal()    && resource.data.ubicacion.estado == miEstado()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal()  && resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional()   && resource.data.gerencia == miGerencia()) ||
        (esReporteEstadal()    && resource.data.ubicacion.estado == miEstado())
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal() && request.resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerencia == miGerencia())
      );

      allow update: if esControl()
                    || resource.data.usuarioId == request.auth.uid;

      allow delete: if esControl()
                    || (resource.data.usuarioId == request.auth.uid
                        && resource.data.planificacionId == null);
    }

    /* ========== EMAILS LOOKUP ========== */
    match /emails-lookup/{hashEmail} {
      allow get: if true;
      allow list: if false;

      allow create: if isAuth()
                    && request.resource.data.uid is string
                    && (
                      request.resource.data.uid == request.auth.uid
                      || esControl()
                    );

      allow update: if false;
      allow delete: if esControl();
    }

    /* ========== INTENTOS PUBLICOS ========== */
    match /intentos-publicos/{uid} {
      // get sigue público (login anónimo lo necesita).
      // list SOLO para control, para que el panel lea los contadores.
      allow get: if true;
      allow list: if isAuth() && esControl();

      // Create: SOLO se puede iniciar el contador en 1.
      // Antes se aceptaba 1..3, lo cual permitía a un atacante anónimo
      // crear el doc directamente con contador=3 y bloquear a la víctima
      // de una sola escritura.
      allow create: if
        request.resource.data.contador is number
        && request.resource.data.contador == 1;

      // Update: rate-limitado, incremento de a 1.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contador','ultimo'])
        && request.resource.data.contador is number
        && request.resource.data.contador == resource.data.contador + 1
        && request.resource.data.contador <= 3
        && (
          !('ultimo' in resource.data)
          || request.time > resource.data.ultimo + duration.value(15, 's')
        );

      allow delete: if isAuth() && (request.auth.uid == uid || esControl());
    }

    /* ========== PERSONAL ========== */
    match /personal/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardNacional() || esDashboardEstadal() ||
        (esReporteEstadal()  && resource.data.estado == miEstado()) ||
        (esReporteNacional() && resource.data.gerencia == miGerencia())
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardNacional() || esDashboardEstadal() ||
        (esReporteEstadal()  && resource.data.estado == miEstado()) ||
        (esReporteNacional() && resource.data.gerencia == miGerencia())
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal()  && request.resource.data.estado == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerencia == miGerencia())
      );

      allow update, delete: if esControl()
        || (isAuth() && resource.data.creadoPor == request.auth.uid);
    }

    /* ========== PLANIFICACIÓN ========== */
    match /planificacion/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteEstadal()  && resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteEstadal()  && resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal()  && request.resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerenciaUsuario == miGerencia())
      );

      allow update, delete: if esControl()
                            || resource.data.usuarioId == request.auth.uid;
    }

    /* ========== REPORTES ESPECIALES ========== */
    match /reportesEspeciales/{id} {
      allow get: if isAuth();
      allow list: if isAuth();
      allow create, delete: if esControl();

      allow update: if esControl()
        || (
          isAuth()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas'])
          && request.resource.data.respuestas.size() == resource.data.respuestas.size() + 1
        );
    }

    /* ========== VIVEROS ========== */
    match /viveros/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Producción') ||
        (esDashboardNacional() && miGerencia() == 'Producción') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Producción') ||
        (esDashboardNacional() && miGerencia() == 'Producción') ||
        esDashboardEstadal()
      );

      allow create, update, delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Producción')
      );
    }

    /* ========== BANCOS DE TIERRA ========== */
    match /bancosTierra/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Plantación') ||
        (esDashboardNacional() && miGerencia() == 'Plantación') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Plantación') ||
        (esDashboardNacional() && miGerencia() == 'Plantación') ||
        esDashboardEstadal()
      );

      allow create, update, delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Plantación')
      );
    }

    /* ========== BRIGADAS ========== */
    match /brigadas/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Organización') ||
        (esDashboardNacional() && miGerencia() == 'Organización') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Organización') ||
        (esDashboardNacional() && miGerencia() == 'Organización') ||
        esDashboardEstadal()
      );

      allow create: if isAuth() && (
        (esControl() || (esReporteNacional() && miGerencia() == 'Organización'))
        && request.resource.data.tipo == 'ecologica'
      );

      allow update: if isAuth() && (
        (esControl() || (esReporteNacional() && miGerencia() == 'Organización'))
        && request.resource.data.tipo == 'ecologica'
      );

      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      );
    }

    /* ========== CONTADORES ========== */
    match /contadores/{tipo} {
      allow get: if isAuth();

      allow create: if isAuth()
                    && request.resource.data.ultimo is number
                    && request.resource.data.ultimo > 0;

      allow update: if isAuth()
                    && request.resource.data.ultimo is number
                    && request.resource.data.ultimo > resource.data.ultimo;

      allow delete: if false;
    }

    /* ========== FORMACIONES ========== */
    match /formaciones/{id} {
      allow get, list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardEstadal() ||
        ((esReporteNacional() || esDashboardNacional()) && miGerencia() == 'Formación')
      );

      allow create: if isAuth()
                    && (esControl() || (esReporteNacional() && miGerencia() == 'Formación'))
                    && request.resource.data.codigoUnico is string
                    && request.resource.data.codigoUnico.matches('^FRM-[0-9]{6}$')
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0
                    && request.resource.data.estatus in ['planificada', 'en_curso', 'finalizada', 'cancelada'];

      allow update: if isAuth()
                    && (esControl() || (esReporteNacional() && miGerencia() == 'Formación'))
                    && request.resource.data.estatus in ['planificada', 'en_curso', 'finalizada', 'cancelada'];

      allow delete: if esControl();
    }

  } /* <- cierra /databases */
} /* <- cierra service */