rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ========== HELPERS ========== */
    function isAuth() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function rol() {
      return isAuth() ? userDoc().rol : '';
    }
    // F01: Cuenta activa (aprobada y no suspendida)
    function cuentaActiva() {
      return isAuth()
        && userDoc().estadoCuenta == 'aprobado'
        && userDoc().suspendido != true;
    }
    function esControl()          { return cuentaActiva() && rol() == 'control'; }
    function esVisorNacional()    { return cuentaActiva() && rol() == 'visor_nacional'; }
    function esReporteNacional()  { return cuentaActiva() && rol() == 'reporte_nacional'; }
    function esReporteEstadal()   { return cuentaActiva() && rol() == 'reporte_estadal'; }
    function esDashboardNacional(){ return cuentaActiva() && rol() == 'dashboard_nacional'; }
    function esDashboardEstadal() { return cuentaActiva() && rol() == 'dashboard_estadal'; }
    function miEstado()   { return userDoc().estado; }
    function miGerencia() { return userDoc().gerencia; }

    /* ========== USUARIOS ========== */
    match /usuarios/{uid} {
      // Control puede leer incluso cuentas pendientes (para poder aprobarlas)
      allow get: if isAuth() && (
        request.auth.uid == uid
        || (rol() == 'control')
      );
      allow list: if isAuth() && rol() == 'control';
      allow create: if isAuth()
                    && request.auth.uid == uid
                    && request.resource.data.rol in [
                         'reporte_estadal', 'reporte_nacional', 'visor_nacional',
                         'dashboard_nacional', 'dashboard_estadal'
                       ]
                    && request.resource.data.estadoCuenta == 'pendiente';

      allow update: if
        (isAuth() && rol() == 'control')
        ||
        (
          isAuth() && request.auth.uid == uid
          && (
            !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['rol','estadoCuenta','estado','gerencia','suspendido','cedula','email','intentosFallidos','ultimoIntentoFallido'])
            ||
            (
              request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly(['intentosFallidos','ultimoIntentoFallido','suspendido'])
              && request.resource.data.intentosFallidos == 0
              && request.resource.data.suspendido == false
            )
          )
        );
      allow delete: if isAuth() && rol() == 'control';
    }

    /* ========== CÉDULAS ========== */
    match /cedulas/{hashId} {
      // F02: get ahora requiere autenticación (el flujo de registro la usa ya autenticado)
      allow get: if isAuth();
      allow list: if isAuth() && esControl();
      allow create: if isAuth()
                    && request.resource.data.uid == request.auth.uid
                    && !exists(/databases/$(database)/documents/cedulas/$(hashId));
      allow delete: if isAuth() && esControl();
    }

    /* ========== REPORTES ========== */
    match /reportes/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal()  && resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional()   && resource.data.gerencia == miGerencia()) ||
        (esReporteEstadal()    && resource.data.ubicacion.estado == miEstado()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal()  && resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional()   && resource.data.gerencia == miGerencia()) ||
        (esReporteEstadal()    && resource.data.ubicacion.estado == miEstado())
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal() && request.resource.data.ubicacion.estado == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerencia == miGerencia())
      );

      // F04: hasOnly() en update (el propietario NO puede reescribir usuarioId, gerencia, ubicacion raíz)
      allow update: if isAuth() && (
        esControl()
        ||
        (
          resource.data.usuarioId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['datosGenerales','detalleIndicador','cierre','participantes',
                         'actividad','observaciones','camposEspecificos',
                         'planificacionId','planificacionActividadNumero'])
        )
      );

      allow delete: if isAuth() && (
        esControl()
        || (resource.data.usuarioId == request.auth.uid
            && resource.data.planificacionId == null)
      );
    }

    /* ========== EMAILS LOOKUP ========== */
    match /emails-lookup/{hashEmail} {
      // Se mantiene get público: el flujo de login lo lee ANTES de autenticar
      // para bloquear por intentos fallidos. Documentado como riesgo aceptado (F02).
      allow get: if true;
      allow list: if false;

      allow create: if isAuth()
                    && request.resource.data.uid is string
                    && (
                      request.resource.data.uid == request.auth.uid
                      || esControl()
                    );

      allow update: if false;
      allow delete: if isAuth() && esControl();
    }

    /* ========== INTENTOS PUBLICOS ========== */
    match /intentos-publicos/{uid} {
      allow get: if true;
      allow list: if isAuth() && esControl();

      allow create: if
        request.resource.data.contador is number
        && request.resource.data.contador == 1;

      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contador','ultimo'])
        && request.resource.data.contador is number
        && request.resource.data.contador == resource.data.contador + 1
        && request.resource.data.contador <= 3
        && (
          !('ultimo' in resource.data)
          || request.time > resource.data.ultimo + duration.value(15, 's')
        );

      allow delete: if isAuth() && (request.auth.uid == uid || esControl());
    }

    /* ========== PERSONAL ========== */
    // F03: dashboards solo pueden leer de su estado/gerencia
    match /personal/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal() && resource.data.estado == miEstado()) ||
        (esReporteEstadal()  && resource.data.estado == miEstado()) ||
        (esReporteNacional() && resource.data.gerencia == miGerencia())
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerencia == miGerencia()) ||
        (esDashboardEstadal() && resource.data.estado == miEstado()) ||
        (esReporteEstadal()  && resource.data.estado == miEstado()) ||
        (esReporteNacional() && resource.data.gerencia == miGerencia())
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal()  && request.resource.data.estado == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerencia == miGerencia())
      );

      // F07: hasOnly en update
      allow update: if isAuth() && (
        esControl() ||
        (
          resource.data.creadoPor == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nombreCompleto','cedula','telefono','correo',
                         'tieneWhatsapp','tieneTelegram','tallaCamisa',
                         'tallaPantalon','tallaZapato','tallaGorra',
                         'cargo','activo','actualizado'])
        )
      );

      allow delete: if isAuth() && esControl();
    }

    /* ========== PLANIFICACIÓN ========== */
    // F10: agregar acceso a dashboards
    match /planificacion/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        (esDashboardEstadal() && resource.data.estadoUsuario == miEstado()) ||
        (esReporteEstadal()  && resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esDashboardNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        (esDashboardEstadal() && resource.data.estadoUsuario == miEstado()) ||
        (esReporteEstadal()  && resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && resource.data.gerenciaUsuario == miGerencia()) ||
        resource.data.usuarioId == request.auth.uid
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteEstadal()  && request.resource.data.estadoUsuario == miEstado()) ||
        (esReporteNacional() && request.resource.data.gerenciaUsuario == miGerencia())
      );

      // F07: hasOnly en update
      allow update: if isAuth() && (
        esControl() ||
        (
          resource.data.usuarioId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['actividades','estado','fechaActualizacion'])
        )
      );

      allow delete: if isAuth() && (
        esControl()
        || resource.data.usuarioId == request.auth.uid
      );
    }

    /* ========== REPORTES ESPECIALES ========== */
    // F08: append-only en respuestas, validar que sea la propia respuesta del usuario
    match /reportesEspeciales/{id} {
      allow get: if isAuth() && cuentaActiva();
      allow list: if isAuth() && cuentaActiva();
      allow create, delete: if isAuth() && esControl();

      allow update: if isAuth() && (
        esControl()
        ||
        (
          cuentaActiva()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas'])
          && request.resource.data.respuestas.size() == resource.data.respuestas.size() + 1
          && request.resource.data.respuestas[resource.data.respuestas.size()].usuarioId == request.auth.uid
        )
      );
    }

    /* ========== VIVEROS ========== */
    match /viveros/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Producción') ||
        (esDashboardNacional() && miGerencia() == 'Producción') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Producción') ||
        (esDashboardNacional() && miGerencia() == 'Producción') ||
        esDashboardEstadal()
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Producción')
      );

      // F07: hasOnly en update
      allow update: if isAuth() && (
        esControl() ||
        (
          esReporteNacional() && miGerencia() == 'Producción'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['nombre','tipo','ubicacion','capacidad','plantasActuales',
                         'estatus','responsable','telefono','observaciones',
                         'latitud','longitud','actualizado'])
        )
      );

      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Producción')
      );
    }

    /* ========== BANCOS DE TIERRA ========== */
    match /bancosTierra/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Plantación') ||
        (esDashboardNacional() && miGerencia() == 'Plantación') ||
        esDashboardEstadal()
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Plantación') ||
        (esDashboardNacional() && miGerencia() == 'Plantación') ||
        esDashboardEstadal()
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Plantación')
      );

      allow update, delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Plantación')
      );
    }

    /* ========== BRIGADAS ========== */
    match /brigadas/{id} {
      allow get: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Organización') ||
        (esDashboardNacional() && miGerencia() == 'Organización') ||
        esDashboardEstadal() ||
        // F12: Formación puede leer brigadas para vincular núcleos
        (esReporteNacional() && miGerencia() == 'Formación')
      );

      allow list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        (esReporteNacional() && miGerencia() == 'Organización') ||
        (esDashboardNacional() && miGerencia() == 'Organización') ||
        esDashboardEstadal() ||
        (esReporteNacional() && miGerencia() == 'Formación')
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      ) && request.resource.data.tipo == 'ecologica';

      allow update: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      ) && request.resource.data.tipo == 'ecologica';

      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      );
    }

    /* ========== CONTADORES ========== */
    // F09: límite superior + incremento de a 1
    match /contadores/{tipo} {
      allow get: if isAuth() && cuentaActiva();

      allow create: if isAuth() && cuentaActiva()
                    && request.resource.data.keys().hasOnly(['ultimo', 'actualizado'])
                    && request.resource.data.ultimo is number
                    && request.resource.data.ultimo > 0
                    && request.resource.data.ultimo <= 1000000;

      allow update: if isAuth() && cuentaActiva()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['ultimo', 'actualizado'])
                    && request.resource.data.ultimo is number
                    && request.resource.data.ultimo > resource.data.ultimo
                    && request.resource.data.ultimo <= resource.data.ultimo + 1;

      allow delete: if false;
    }

    /* ========== FORMACIONES ========== */
    match /formaciones/{id} {
      allow get, list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardEstadal() ||
        ((esReporteNacional() || esDashboardNacional()) && miGerencia() == 'Formación')
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Formación')
      )
        && request.resource.data.codigoUnico is string
        && request.resource.data.codigoUnico.matches('^FRM-[0-9]{6}$')
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.estatus in ['planificada', 'en_curso', 'finalizada', 'cancelada'];

      // F07: hasOnly en update
      allow update: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Formación')
      )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['titulo','tipo','tema','descripcion','fechaInicio','fechaFin',
                       'duracionHoras','modalidad','facilitador','ubicacion',
                       'participantes','estatus','evidencia','observaciones','actualizado'])
        && request.resource.data.estatus in ['planificada', 'en_curso', 'finalizada', 'cancelada'];

      allow delete: if isAuth() && esControl();
    }

    /* ========== COMITÉS ECOSOCIALISTAS ========== */
    match /comitesEcosocialistas/{id} {
      allow get, list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardEstadal() ||
        ((esReporteNacional() || esDashboardNacional()) && miGerencia() == 'Organización') ||
        // F12: Formación puede leer comités para vincular núcleos
        (esReporteNacional() && miGerencia() == 'Formación')
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      )
        && request.resource.data.codigoUnico is string
        && request.resource.data.codigoUnico.matches('^COM-[0-9]{6}$');

      allow update: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombre','ubicacion','estatus','responsable','telefono',
                       'observaciones','descripcion','actualizado']);

      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      );
    }

    /* ========== CONSEJOS ECOSOCIALISTAS ========== */
    match /consejosEcosocialistas/{id} {
      allow get, list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardEstadal() ||
        ((esReporteNacional() || esDashboardNacional()) && miGerencia() == 'Organización') ||
        (esReporteNacional() && miGerencia() == 'Formación')
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      )
        && request.resource.data.codigoUnico is string
        && request.resource.data.codigoUnico.matches('^CON-[0-9]{6}$');

      allow update: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombre','ubicacion','estatus','responsable','telefono',
                       'observaciones','descripcion','actualizado']);

      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Organización')
      );
    }

    /* ========== NÚCLEOS FORMATIVOS ========== */
    match /nucleos/{id} {
      allow get, list: if isAuth() && (
        esControl() ||
        esVisorNacional() ||
        esDashboardEstadal() ||
        ((esReporteNacional() || esDashboardNacional()) && miGerencia() == 'Formación')
      );

      allow create: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Formación')
      )
        && request.resource.data.codigoUnico is string
        && request.resource.data.codigoUnico.matches('^NUC-[0-9]{6}$');

      allow update: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Formación')
      )
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nombre','territorio','vinculadoA','estatus','responsable',
                       'telefono','observaciones','descripcion','actualizado']);

      // F12: Formación también puede borrar sus propios núcleos (alineado con UI)
      allow delete: if isAuth() && (
        esControl() ||
        (esReporteNacional() && miGerencia() == 'Formación')
      );
    }

    /* ========== VOLUNTARIADO (formulario público) ========== */
    match /voluntarios/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'nombre','cedula','telefono','correo','estado','municipio',
          'parroquia','comuna','consejo','intereses','comentario',
          'aprobado','creadoEn'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 200
        && request.resource.data.cedula is string
        && request.resource.data.cedula.size() > 0
        && request.resource.data.cedula.size() <= 30
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() > 0
        && request.resource.data.telefono.size() <= 30
        && request.resource.data.estado is string
        && request.resource.data.estado.size() > 0
        && request.resource.data.municipio is string
        && request.resource.data.municipio.size() > 0
        && request.resource.data.parroquia is string
        && request.resource.data.parroquia.size() > 0
        && request.resource.data.aprobado == false;

      allow get, list: if isAuth() && esControl() || esVisorNacional();
      allow update, delete: if isAuth() && esControl();
    }

  } /* <- cierra /databases */
} /* <- cierra service */